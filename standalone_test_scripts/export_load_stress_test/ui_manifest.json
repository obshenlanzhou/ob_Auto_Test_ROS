{
  "schema_version": 1,
  "id": "export_load_stress_test",
  "title": "参数导入导出压测",
  "description": "交替导入配置 JSON、导出设备参数并比较一致性。",
  "script": "export_load_stress_test.py",
  "risk": "normal",
  "stop_policy": "immediate",
  "fields": [
    {"name": "ros_version", "option": "--ros-version", "type": "select", "label": "ROS 版本", "section": "basic", "default": "2", "choices": [{"value": "2", "label": "ROS 2"}, {"value": "1", "label": "ROS 1"}]},
    {"name": "ros_setup", "option": "--ros-setup", "type": "path", "label": "ROS Setup", "section": "basic", "default": "/opt/ros/humble/setup.bash"},
    {"name": "driver_setup", "option": "--driver-setup", "type": "path", "label": "Driver Setup", "section": "basic", "default": "", "placeholder": "/path/to/orbbec_camera/install/setup.bash"},
    {"name": "launch_file", "option": "--launch-file", "type": "path", "label": "Launch 文件", "section": "basic", "default": "gemini_330_series_sdk_json.launch.py"},
    {"name": "config_jsons", "option": "--config-json", "type": "list", "label": "配置 JSON（每行一个）", "section": "basic", "default": [], "placeholder": "/path/to/Gemini_336L_1.json\n/path/to/Gemini_336L_2.json"},
    {"name": "cameras", "option": "--camera", "type": "camera-list", "label": "相机", "section": "basic", "default": []},
    {"name": "run_count", "option": "--run-count", "type": "integer", "label": "最大循环次数", "section": "basic", "default": "10", "min": 1},
    {"name": "duration", "option": "--duration", "type": "duration", "label": "最长运行时间", "section": "basic", "default": ""},
    {"name": "image_topics", "option": "--image-topic", "type": "list", "label": "图像 Topic 模板", "section": "basic", "default": [], "placeholder": "/{camera}/color/image_raw\n/{camera}/depth/image_raw"},
    {"name": "save_image_count", "option": "--save-image-count", "type": "integer", "label": "每 Topic 存图数", "section": "basic", "default": "1", "min": 0},
    {"name": "launch_package", "option": "--launch-package", "type": "text", "label": "Launch Package", "section": "advanced", "default": "orbbec_camera"},
    {"name": "launch_args", "option": "--launch-arg", "type": "list", "label": "Launch 参数（每行一个）", "section": "advanced", "default": ["enable_heartbeat=true", "enable_firmware_log=true"], "placeholder": "enable_heartbeat=true\nenable_firmware_log=true"},
    {"name": "sdk_log_level", "option": "--sdk-log-level", "type": "select", "label": "SDK 日志级别", "section": "advanced", "default": "debug", "choices": ["debug", "info", "warn", "error", "fatal", "none"]},
    {"name": "stable_seconds", "option": "--stable-seconds", "type": "duration", "label": "稳定出流时间", "section": "advanced", "default": "5"},
    {"name": "stream_timeout", "option": "--stream-timeout", "type": "duration", "label": "出流超时", "section": "advanced", "default": "60"},
    {"name": "max_gap_seconds", "option": "--max-gap-seconds", "type": "duration", "label": "最大帧间隔", "section": "advanced", "default": "1.5"},
    {"name": "restart_delay", "option": "--restart-delay", "type": "number", "label": "循环间隔秒数", "section": "advanced", "default": "2", "min": 0},
    {"name": "queue_size", "option": "--queue-size", "type": "integer", "label": "Queue Size", "section": "advanced", "default": "10", "min": 1},
    {"name": "save_image_timeout", "option": "--save-image-timeout", "type": "duration", "label": "存图超时", "section": "advanced", "default": "30"},
    {"name": "jpg_quality", "option": "--jpg-quality", "type": "integer", "label": "JPG 质量", "section": "advanced", "default": "95", "min": 1, "max": 100},
    {"name": "export_service", "option": "--export-service", "type": "text", "label": "导出 Service", "section": "advanced", "default": "/{camera}/export_config_json"},
    {"name": "export_service_type", "option": "--export-service-type", "type": "text", "label": "导出 Service 类型", "section": "advanced", "default": "orbbec_camera_msgs/srv/SetString"},
    {"name": "service_timeout", "option": "--service-timeout", "type": "duration", "label": "Service 超时", "section": "advanced", "default": "30"}
  ]
}
