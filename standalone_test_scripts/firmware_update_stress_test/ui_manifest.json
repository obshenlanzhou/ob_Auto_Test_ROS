{
  "schema_version": 1,
  "id": "firmware_update_stress_test",
  "title": "固件升级压测",
  "description": "循环调用固件升级工具并校验成功日志；停止时等待当前升级完成。",
  "script": "firmware_update_stress_test.py",
  "risk": "high",
  "stop_policy": "safe-point",
  "confirmation": "固件升级会写入相机设备。请确认固件与目标设备匹配，并保持供电和连接稳定。",
  "required_any": [
    {"fields": ["duration", "run_count"], "message": "压测时间和压测次数至少填写一项"}
  ],
  "fields": [
    {"name": "ros_version", "option": "--ros-version", "type": "select", "label": "ROS 版本", "label_en": "ROS Version", "group": "environment", "section": "basic", "default": "2", "choices": [{"value": "2", "label": "ROS 2"}, {"value": "1", "label": "ROS 1"}]},
    {"name": "ros_setup", "option": "--ros-setup", "type": "path", "label": "ROS 环境脚本", "label_en": "ROS Setup", "group": "environment", "section": "basic", "default": "/opt/ros/humble/setup.bash"},
    {"name": "driver_setup", "option": "--driver-setup", "type": "path", "label": "驱动环境脚本", "label_en": "Driver Setup", "group": "environment", "section": "basic", "default": "", "placeholder": "/path/to/orbbec_camera/install/setup.bash"},
    {"name": "firmwares", "option": "--firmware", "type": "list", "label": "固件文件", "label_en": "Firmware Files", "group": "configuration", "section": "basic", "default": [], "required": true, "placeholder": "/path/to/firmware_a.bin\n/path/to/firmware_b.bin"},
    {"name": "cameras", "option": "--camera", "type": "camera-list", "label": "目标相机", "label_en": "Target Cameras", "group": "cameras", "section": "basic", "default": []},
    {"name": "run_count", "option": "--run-count", "type": "integer", "label": "最大升级次数", "label_en": "Update Count", "group": "limits", "section": "basic", "default": "", "min": 1, "placeholder": "10", "note": "与最长运行时间至少填写一项，可同时填写。"},
    {"name": "duration", "option": "--duration", "type": "duration", "label": "最长运行时间", "label_en": "Duration", "group": "limits", "section": "basic", "default": "", "placeholder": "300", "note": "与最大升级次数至少填写一项，可同时填写。"},
    {"name": "restart_delay", "option": "--restart-delay", "type": "number", "label": "升级间隔", "label_en": "Update Delay", "group": "advanced", "section": "advanced", "default": "2", "min": 0},
    {"name": "reconnect_timeout_sec", "option": "--reconnect-timeout-sec", "type": "integer", "label": "重连超时", "label_en": "Reconnect Timeout", "group": "advanced", "section": "advanced", "default": "120", "min": 1},
    {"name": "reconnect_poll_ms", "option": "--reconnect-poll-ms", "type": "integer", "label": "重连轮询间隔", "label_en": "Reconnect Poll Interval", "group": "advanced", "section": "advanced", "default": "1000", "min": 1},
    {"name": "sdk_log_level", "option": "--sdk-log-level", "type": "select", "label": "SDK 日志级别", "label_en": "SDK Log Level", "group": "advanced", "section": "advanced", "default": "debug", "choices": ["debug", "info", "warn", "error", "fatal", "off", "none"]},
    {"name": "continue_on_error", "option": "--continue-on-error", "type": "flag", "label": "遇错继续", "label_en": "Continue on Error", "group": "advanced", "section": "advanced", "default": false}
  ]
}
