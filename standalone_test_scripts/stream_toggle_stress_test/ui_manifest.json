{
  "schema_version": 1,
  "id": "stream_toggle_stress_test",
  "version": "1.9.6",
  "title": "开关流压测",
  "description": "支持逐路或整体关闭和恢复图像流，可在两组分辨率/帧率/出流格式配置间交替切换，并验证单/多相机目标流稳定恢复。",
  "script": "stream_toggle_stress_test.py",
  "risk": "normal",
  "stop_policy": "immediate",
  "required_any": [
    {"fields": ["duration", "run_count"], "message": "压测时间和压测次数至少填写一项"}
  ],
  "fields": [
    {"name": "ros_version", "option": "--ros-version", "type": "select", "label": "ROS 版本", "label_en": "ROS Version", "group": "environment", "section": "basic", "default": "2", "choices": [{"value": "2", "label": "ROS 2"}, {"value": "1", "label": "ROS 1"}]},
    {"name": "ros_setup", "option": "--ros-setup", "type": "path", "label": "ROS 环境脚本", "label_en": "ROS Setup", "group": "environment", "section": "basic", "default": "/opt/ros/humble/setup.bash"},
    {"name": "driver_setup", "option": "--driver-setup", "type": "path", "label": "驱动环境脚本", "label_en": "Driver Setup", "group": "environment", "section": "basic", "default": "", "placeholder": "/path/to/orbbec_camera/install/setup.bash"},
    {"name": "launch_file", "option": "--launch-file", "type": "path", "label": "Launch 文件", "label_en": "Launch File", "group": "configuration", "section": "basic", "default": "", "placeholder": "gemini_330_series.launch.py"},
    {"name": "cameras", "option": "--camera", "type": "camera-list", "label": "单相机启动参数", "label_en": "Single-camera Arguments", "group": "cameras", "section": "basic", "default": [], "max_items": 1, "note": "仅用于单相机 launch 参数注入；预配置多相机 launch 请留空。"},
    {"name": "image_topics", "option": "--image-topic", "type": "list", "label": "目标图像话题", "label_en": "Target Image Topics", "group": "configuration", "section": "basic", "default": [], "placeholder": "/camera_01/color/image_raw\n/camera_02/depth/image_raw", "note": "留空时自动发现具有 toggle 服务的所有原始图像流。"},
    {"name": "save_image_topics", "option": "--save-image-topic", "type": "list", "label": "存图话题", "label_en": "Image Save Topics", "group": "configuration", "section": "basic", "default": [], "placeholder": "/camera_01/color/image_raw\n/camera_01/color/image_raw/compressed", "note": "留空时保存目标原始图；可同时配置目标 image_raw 及其 /compressed 话题。"},
    {"name": "point_cloud_topics", "option": "--point-cloud-topic", "type": "list", "label": "点云话题", "label_en": "Point Cloud Topics", "group": "configuration", "section": "basic", "default": [], "placeholder": "留空则开关前自动发现\n/{camera}/depth/points\n/{camera}/depth_registered/points"},
    {"name": "imu_topics", "option": "--imu-topic", "type": "list", "label": "IMU 话题", "label_en": "IMU Topics", "group": "configuration", "section": "basic", "default": [], "placeholder": "留空则开关前自动发现\n/{camera}/accel/sample\n/{camera}/gyro/sample\n/{camera}/gyro_accel/sample"},
    {"name": "toggle_mode", "option": "--toggle-mode", "type": "select", "label": "开关模式", "label_en": "Toggle Mode", "group": "configuration", "section": "basic", "default": "individual", "choices": [{"value": "individual", "label": "逐路开关"}, {"value": "all", "label": "整体开关（当前仅 ROS2）"}]},
    {"name": "switch_stream_profile", "option": "--switch-stream-profile", "type": "select", "label": "切换分辨率和帧率", "label_en": "Switch Resolution and FPS", "group": "configuration", "section": "basic", "default": "0", "choices": [{"value": "0", "label": "不切换"}, {"value": "1", "label": "切换"}], "note": "设为 1 时必须分别配置 A、B 两组相同图像话题的分辨率和帧率。"},
    {"name": "stream_profile_a", "option": "--stream-profile-a", "type": "list", "label": "图像配置 A", "label_en": "Image Profile Set A", "group": "configuration", "section": "basic", "default": [], "placeholder": "/camera/color/image_raw=1280x720@30:MJPG\n/camera/depth/image_raw=640x480@30:Y16", "note": "每行格式：图像话题=宽x高@帧率:出流格式；格式可省略以保持当前值。"},
    {"name": "stream_profile_b", "option": "--stream-profile-b", "type": "list", "label": "图像配置 B", "label_en": "Image Profile Set B", "group": "configuration", "section": "basic", "default": [], "placeholder": "/camera/color/image_raw=640x480@15:RGB888\n/camera/depth/image_raw=320x240@15:Y16", "note": "必须与配置 A 包含相同话题；每台相机的分辨率、帧率或可观测 ROS encoding 至少一项不同。"},
    {"name": "stream_on_preview_seconds", "option": "--stream-on-preview-seconds", "type": "duration", "label": "开流+预览时间", "label_en": "Stream On and Preview Time", "group": "configuration", "section": "basic", "default": "4", "note": "开流后持续预览并验证出流，单位秒，可配置任意正数。"},
    {"name": "stream_off_seconds", "option": "--stream-off-seconds", "type": "duration", "label": "关流时间", "label_en": "Stream Off Time", "group": "configuration", "section": "basic", "default": "4", "note": "保持并验证关流状态，单位秒，可配置任意正数。"},
    {"name": "duration", "option": "--duration", "type": "duration", "label": "最长运行时间", "label_en": "Duration", "group": "limits", "section": "basic", "default": "", "placeholder": "300", "note": "与最大完整循环数至少填写一项，可同时填写。"},
    {"name": "run_count", "option": "--run-count", "type": "integer", "label": "最大完整循环数", "label_en": "Run Count", "group": "limits", "section": "basic", "default": "", "min": 1, "placeholder": "10", "note": "与最长运行时间至少填写一项，可同时填写。"},
    {"name": "continue_on_failure", "option": "--continue-on-failure", "type": "flag", "label": "失败后继续", "label_en": "Continue on Failure", "group": "limits", "section": "basic", "default": false, "note": "关闭时首个失败即停止；开启后恢复流并继续后续循环，最终结果仍为失败。"},
    {"name": "save_image_count", "option": "--save-image-count", "type": "integer", "label": "每路每循环存图数", "label_en": "Artifacts per Stream", "group": "configuration", "section": "basic", "default": 1, "min": 0, "note": "统一控制图像、点云预览和 IMU 曲线；0 仅检测不存图。"},
    {"name": "launch_package", "option": "--launch-package", "type": "text", "label": "Launch 包", "label_en": "Launch Package", "group": "advanced", "section": "advanced", "default": "orbbec_camera"},
    {"name": "launch_args", "option": "--launch-arg", "type": "list", "label": "附加 Launch 参数", "label_en": "Launch Arguments", "group": "advanced", "section": "advanced", "default": ["enable_heartbeat=true", "enable_firmware_log=true"], "placeholder": "enable_heartbeat=true\nenable_firmware_log=true"},
    {"name": "sdk_log_level", "option": "--sdk-log-level", "type": "select", "label": "SDK 日志级别", "label_en": "SDK Log Level", "group": "advanced", "section": "advanced", "default": "debug", "choices": ["debug", "info", "warn", "error", "fatal", "none"]},
    {"name": "topic_discovery_timeout", "option": "--topic-discovery-timeout", "type": "duration", "label": "话题发现超时", "label_en": "Topic Discovery Timeout", "group": "advanced", "section": "advanced", "default": "30"},
    {"name": "topic_discovery_settle", "option": "--topic-discovery-settle", "type": "duration", "label": "发现静默窗口", "label_en": "Discovery Settle Window", "group": "advanced", "section": "advanced", "default": "2"},
    {"name": "stream_timeout", "option": "--stream-timeout", "type": "duration", "label": "状态验证超时", "label_en": "State Verification Timeout", "group": "advanced", "section": "advanced", "default": "20"},
    {"name": "max_gap_seconds", "option": "--max-gap-seconds", "type": "duration", "label": "最大帧间隔", "label_en": "Maximum Frame Gap", "group": "advanced", "section": "advanced", "default": "1.5"},
    {"name": "service_timeout", "option": "--service-timeout", "type": "duration", "label": "服务调用超时", "label_en": "Service Timeout", "group": "advanced", "section": "advanced", "default": "15"},
    {"name": "service_retry_delay", "option": "--service-retry-delay", "type": "number", "label": "服务重试间隔", "label_en": "Service Retry Delay", "group": "advanced", "section": "advanced", "default": "1", "min": 0},
    {"name": "save_image_timeout", "option": "--save-image-timeout", "type": "duration", "label": "存图超时", "label_en": "Image Save Timeout", "group": "advanced", "section": "advanced", "default": "30"},
    {"name": "queue_size", "option": "--queue-size", "type": "integer", "label": "订阅队列大小", "label_en": "Queue Size", "group": "advanced", "section": "advanced", "default": 10, "min": 1}
  ]
}
