{
  "schema_version": 1,
  "id": "preset_upgrade_stress_test",
  "title": "Preset 升级压测",
  "description": "交替升级两份深度 Preset，并验证相机 Launch 与图像流。",
  "script": "preset_upgrade_stress_test.py",
  "risk": "high",
  "stop_policy": "safe-point",
  "confirmation": "Preset 升级会写入相机设备。请确认文件与相机型号匹配；停止命令会等待当前升级完成。",
  "required_any": [
    {"fields": ["duration", "run_count"], "message": "压测时间和压测次数至少填写一项"}
  ],
  "fields": [
    {"name": "ros_version", "option": "--ros-version", "type": "select", "label": "ROS 版本", "label_en": "ROS Version", "group": "environment", "section": "basic", "default": "2", "choices": [{"value": "2", "label": "ROS 2"}, {"value": "1", "label": "ROS 1"}]},
    {"name": "ros_setup", "option": "--ros-setup", "type": "path", "label": "ROS 环境脚本", "label_en": "ROS Setup", "group": "environment", "section": "basic", "default": "/opt/ros/humble/setup.bash"},
    {"name": "driver_setup", "option": "--driver-setup", "type": "path", "label": "驱动环境脚本", "label_en": "Driver Setup", "group": "environment", "section": "basic", "default": "", "placeholder": "/path/to/orbbec_camera/install/setup.bash"},
    {"name": "launch_file", "option": "--launch-file", "type": "path", "label": "Launch 文件", "label_en": "Launch File", "group": "configuration", "section": "basic", "default": "", "placeholder": "gemini_330_series.launch.py"},
    {"name": "cameras", "option": "--camera", "type": "camera-list", "label": "目标相机", "label_en": "Target Cameras", "group": "cameras", "section": "basic", "default": []},
    {"name": "preset_a_path", "option": "--preset-a-path", "type": "path", "label": "Preset A 文件", "label_en": "Preset A File", "group": "configuration", "section": "basic", "default": "", "placeholder": "/path/to/preset_a.bin"},
    {"name": "preset_a_name", "option": "--preset-a-name", "type": "text", "label": "Preset A 名称", "label_en": "Preset A Name", "group": "configuration", "section": "basic", "default": "K High Confidence"},
    {"name": "preset_b_path", "option": "--preset-b-path", "type": "path", "label": "Preset B 文件", "label_en": "Preset B File", "group": "configuration", "section": "basic", "default": "", "placeholder": "/path/to/preset_b.bin"},
    {"name": "preset_b_name", "option": "--preset-b-name", "type": "text", "label": "Preset B 名称", "label_en": "Preset B Name", "group": "configuration", "section": "basic", "default": "K High Accuracy"},
    {"name": "run_count", "option": "--run-count", "type": "integer", "label": "最大升级轮数", "label_en": "Upgrade Rounds", "group": "limits", "section": "basic", "default": "", "min": 1, "placeholder": "10", "note": "与最长运行时间至少填写一项，可同时填写。"},
    {"name": "duration", "option": "--duration", "type": "duration", "label": "最长运行时间", "label_en": "Duration", "group": "limits", "section": "basic", "default": "", "placeholder": "300", "note": "与最大升级轮数至少填写一项，可同时填写。"},
    {"name": "image_topics", "option": "--image-topic", "type": "list", "label": "图像话题模板", "label_en": "Image Topic Templates", "group": "configuration", "section": "basic", "default": [], "placeholder": "留空则自动发现全部原始图像流\n/{camera}/color/image_raw\n/{camera}/color/image_raw/compressed", "note": "Image 保存像素无损 PNG；CompressedImage 的 data 原始字节保存为 JPG。压缩话题必须显式指定。"},
    {"name": "save_image_count", "option": "--save-image-count", "type": "integer", "label": "每话题存图数", "label_en": "Images per Topic", "group": "configuration", "section": "basic", "default": "1", "min": 0},
    {"name": "launch_package", "option": "--launch-package", "type": "text", "label": "Launch 包", "label_en": "Launch Package", "group": "advanced", "section": "advanced", "default": "orbbec_camera"},
    {"name": "launch_args", "option": "--launch-arg", "type": "list", "label": "附加 Launch 参数", "label_en": "Launch Arguments", "group": "advanced", "section": "advanced", "default": ["enable_heartbeat=true", "enable_firmware_log=true"], "placeholder": "enable_heartbeat=true\nenable_firmware_log=true"},
    {"name": "stream_timeout", "option": "--stream-timeout", "type": "duration", "label": "出流超时", "label_en": "Stream Timeout", "group": "advanced", "section": "advanced", "default": "30"},
    {"name": "preset_log_timeout", "option": "--preset-log-timeout", "type": "duration", "label": "Preset 日志超时", "label_en": "Preset Log Timeout", "group": "advanced", "section": "advanced", "default": "20"},
    {"name": "restart_delay", "option": "--restart-delay", "type": "number", "label": "循环间隔", "label_en": "Cycle Delay", "group": "advanced", "section": "advanced", "default": "2", "min": 0},
    {"name": "launch_start_interval", "option": "--launch-start-interval", "type": "number", "label": "相机启动间隔", "label_en": "Launch Start Interval", "group": "advanced", "section": "advanced", "default": "2", "min": 0},
    {"name": "sdk_log_level", "option": "--sdk-log-level", "type": "select", "label": "SDK 日志级别", "label_en": "SDK Log Level", "group": "advanced", "section": "advanced", "default": "debug", "choices": ["debug", "info", "warn", "error", "fatal", "off", "none"]},
    {"name": "queue_size", "option": "--queue-size", "type": "integer", "label": "队列大小", "label_en": "Queue Size", "group": "advanced", "section": "advanced", "default": "10", "min": 1}
  ]
}
